# Copy this file to .env.local and fill in the values from `npx supabase status`

# Supabase local stack URLs (from `npx supabase status` -> API_URL)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (from `npx supabase status` -> PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase service role / secret key - SERVER SIDE ONLY, never expose to browser
# (from `npx supabase status` -> SECRET_KEY)
SUPABASE_SECRET_KEY=sb_secret_...

# Prisma database connection (from `npx supabase status` -> DB_URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct connection (same as DATABASE_URL for local dev)
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Payment gateway HMAC signature key (set to any secret string for local dev)
GATEWAY_X_SIGNATURE_KEY=your_gateway_signature_key_here
